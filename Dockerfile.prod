FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1
WORKDIR /app

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt \
    && groupadd --gid 10001 app \
    && useradd --uid 10001 --gid app --no-create-home app \
    && install -d -o app -g app /data/uploads

COPY app ./app
COPY alembic ./alembic
COPY alembic.ini .
COPY deploy/entrypoint.py ./deploy/entrypoint.py

USER 10001:10001
ENTRYPOINT ["python", "/app/deploy/entrypoint.py"]
CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000", "--workers", "1", "--root-path", "/api", "--no-proxy-headers"]
