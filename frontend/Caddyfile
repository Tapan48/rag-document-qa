{
	admin off
	auto_https off
}

http://:8080 {
	# Allow multipart overhead; the API enforces a 20 MiB file limit.
	request_body {
		max_size 25MB
	}

	handle_path /api/* {
		# Caddy flushes text/event-stream automatically. Keep default
		# disconnect cancellation; do not use flush_interval -1.
		reverse_proxy api:8000
	}

	handle /api {
		redir /api/ 308
	}

	handle /assets/* {
		root * /srv
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	handle {
		root * /srv
		try_files {path} /index.html
		header Cache-Control "no-cache"
		file_server
	}
}
