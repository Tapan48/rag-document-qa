{
	admin off
	http_port 8080
	https_port 8443
}

# No published port: container health must not depend on DNS or certificate issuance.
http://:8081 {
	respond /health "ok" 200
}

{$PUBLIC_HOSTNAME} {
	request_body {
		max_size 25MB
	}

	handle_path /api/* {
		# Default SSE flushing preserves cancellation when the client disconnects.
		reverse_proxy api:8000
	}

	handle /api {
		redir /api/ 308
	}

	handle /assets/* {
		root * /srv
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	handle {
		root * /srv
		try_files {path} /index.html
		header Cache-Control "no-cache"
		file_server
	}
}

# Both domains share public 443. Verify TLS to the isolated ticket proxy too.
event-ticket-booking.duckdns.org {
	reverse_proxy https://ticket-origin:8443 {
		header_up Host {host}
		transport http {
			tls_server_name event-ticket-booking.duckdns.org
		}
	}
}
