FROM node:22-slim AS build
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci
COPY . .
RUN npm run build

FROM caddy:2-alpine
COPY Caddyfile /etc/caddy/Caddyfile
COPY Caddyfile.public /etc/caddy/Caddyfile.public
COPY --from=build /app/dist /srv
# Port 8080 needs no privileged bind capability. Remove the image default
# so the executable can run with Compose's cap_drop: ALL.
RUN setcap -r /usr/bin/caddy \
    && chown -R 10001:10001 /data /config /srv
USER 10001:10001
EXPOSE 8080 8443
