# Copy to .env.production on the server. Never commit the populated file.
# Generate EACH secret independently with: openssl rand -hex 32
POSTGRES_PASSWORD=
JWT_SECRET=
OPENAI_API_KEY=

ACCESS_TOKEN_EXPIRE_MINUTES=30
# Public HTTPS defaults to closed; enable approval after Gmail setup.
REGISTRATION_ENABLED=false
# Keep closed until Gmail and the administrator account have been verified.
# Switch to approval for request -> review -> invitation registration.
REGISTRATION_MODE=closed
ACCESS_NOTIFICATION_EMAIL=tapangarasangi@gmail.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=

# Public HTTPS only: hostname without https:// or a path.
PUBLIC_HOSTNAME=tapan-rag.duckdns.org

EMBEDDING_MODEL=text-embedding-3-small
# Stored vectors and existing migrations use 1536 dimensions.
CHAT_MODEL=gpt-5.6-luna
REASONING_EFFORT=none
RETRIEVAL_TOP_K=5
MAX_OUTPUT_TOKENS=1000

# Optional web research (only used when requested by the user; adds API usage).
WEB_SEARCH_MODEL=gpt-5.6-luna
WEB_SEARCH_MAX_TOOL_CALLS=3
WEB_SEARCH_TIMEOUT_SECONDS=90
WEB_SEARCH_MAX_OUTPUT_TOKENS=3000
ANSWER_TIMEOUT_SECONDS=60
