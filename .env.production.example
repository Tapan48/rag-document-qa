# Copy to .env.production on the server. Never commit the populated file.
# Generate EACH secret independently with: openssl rand -hex 32
POSTGRES_PASSWORD=
JWT_SECRET=
OPENAI_API_KEY=

ACCESS_TOKEN_EXPIRE_MINUTES=30
# Public HTTPS deployment always disables registration in its Compose override.
REGISTRATION_ENABLED=true

EMBEDDING_MODEL=text-embedding-3-small
# Stored vectors and existing migrations use 1536 dimensions.
CHAT_MODEL=gpt-5.6-luna
REASONING_EFFORT=none
RETRIEVAL_TOP_K=5
MAX_OUTPUT_TOKENS=1000
